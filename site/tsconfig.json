{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@i18n": ["../server/src/i18n/core.ts"],
      "@/i18n": ["./src/hero/engine-i18n.ts"],
      "@cafe/*": ["../web/src/features/cafe/*"],
      "@characters": ["../server/src/characters/core/index.ts"],
      "@shared": ["../server/src/protocol.ts"]
    }
  },
  "include": ["src", "scripts"]
}
